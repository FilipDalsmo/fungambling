# No external credentials are required. Copy to .env.local for local development.
# Configure production values in the host environment; never commit local env files.
# Exact browser origin for mutation checks and secure cookies. Use HTTPS in production.
# Include the scheme and optional port, with no path or trailing slash.
APP_ORIGIN=http://localhost:3000
# Writable persistent local disk on a single Node host; never use public/ or /tmp.
# Vercel functions cannot persist/share this SQLite file. See docs/DEPLOYMENT.md.
DATABASE_PATH=./data/fun-gambling.sqlite
# Optional; default false. Set true only behind a trusted proxy that overwrites
# X-Forwarded-For, so clients cannot spoof the IP used for authentication limits.
TRUST_PROXY=false
